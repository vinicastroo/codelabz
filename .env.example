# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

POSTGRES_URL=""
NEXT_PUBLIC_API_URL=""
MAILGUN_API_KEY=""

NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST=""

AWS_REGION =""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Painel /admin (cobrança de mensalidades)
# Gere o hash com: pnpm hash-password "sua-senha"
# IMPORTANTE: o comando acima já imprime o valor com os "$" escapados
# (\$) como abaixo. Isso é necessário porque o Next.js expande "$algo"
# dentro de arquivos .env como se fosse variável — sem o escape, o hash
# bcrypt (cheio de "$") fica corrompido e o login nunca funciona. Esse
# problema é só do arquivo .env local; se você configurar a variável
# pelo painel da Vercel, cole o hash sem escapar.
ADMIN_EMAIL=""
ADMIN_PASSWORD_HASH="\$2b\$12\$..."
ADMIN_SESSION_SECRET=""
ADMIN_NOTIFICATION_EMAIL=""

# Segredo para autorizar as rotas de cron (/api/cron/*). O Vercel Cron
# envia automaticamente "Authorization: Bearer $CRON_SECRET" quando essa
# variável está configurada no projeto.
CRON_SECRET=""

# Fase 2: chave de API do Asaas para cobrança automática (Pix/boleto/
# cartão). Use a chave de Sandbox (contém "_hmlg_") enquanto testa — o
# lib/asaas.ts detecta o ambiente pelo formato da chave e aponta para
# api-sandbox.asaas.com automaticamente.
ASAAS_API_KEY=""

# Token que você mesmo escolhe e cadastra ao criar o Webhook no painel do
# Asaas (Integrações → Webhooks). Precisa bater com o header
# "asaas-access-token" que o Asaas envia em cada evento — sem isso,
# qualquer um poderia forjar uma notificação de pagamento.
ASAAS_WEBHOOK_TOKEN=""